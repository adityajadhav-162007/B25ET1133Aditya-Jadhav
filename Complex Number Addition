#include <iostream>
using namespace std;

class Complex {
    int real, imag;

public:
    void input() {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    Complex add(Complex c) {
        Complex temp;
        temp.real = real + c.real;
        temp.imag = imag + c.imag;
        return temp;
    }

    void display() {
        cout << real << " + " << imag << "i";
    }
};

int main() {
    Complex c1, c2, result;

    cout << "First complex number:\n";
    c1.input();

    cout << "Second complex number:\n";
    c2.input();

    result = c1.add(c2);

    cout << "Sum = ";
    result.display();

    return 0;
}

