#include <iostream>
#include <cstring>
using namespace std;

class String
{
    char str[100];

public:
    // Constructor
    String()
    {
        str[0] = '\0';
    }

    // Accept string
    void Accept()
    {
        cout << "Enter a string: ";
        cin.getline(str, 100);
    }

    // Display string
    void Display()
    {
        cout << "String is: " << str << endl;
    }

    // Destructor
    ~String()
    {
        cout << "Destructor called." << endl;
    }
};

int main()
{
    String s;

    s.Accept();
    s.Display();

    return 0;
}
