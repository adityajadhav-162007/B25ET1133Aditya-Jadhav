#include <iostream>  // Includes the input-output library

using namespace std; // Allows using cout and cin without std::

int main()              // Main function starts
{
    int i, sum = 0;     // Declares i as a loop variable and initializes sum to 0

    cout << "even numbers b/w 1 to 50: "; // Displays a message

    for (i = 2; i <= 50; i += 2) { // Loops through even numbers from 2 to 50

        cout << i << "  "; // Prints the current even number with spaces

        sum += i;          // Adds the current even number to sum
    }

    cout << "\n\nsum:" << sum; // Prints two new lines followed by the total sum

    return 0;             // Ends the program successfully
}
